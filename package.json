{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Order Management service - Node.js, Express, MySQL",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "test": "node --test"
  },
  "dependencies": { "express": "^5.1.0", "mysql2": "^3.14.0" }
}
